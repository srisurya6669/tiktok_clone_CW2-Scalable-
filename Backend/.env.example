PORT=3000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>
JWT_SECRET=change-me-to-a-long-random-string
# Optional: token lifetime (default 7d) and the frontend origin allowed by CORS
# JWT_EXPIRES_IN=7d
# CLIENT_ORIGIN=http://localhost:5173
AZURE_STORAGE_CONNECTION_STRING=<storage account connection string>
AZURE_STORAGE_CONTAINER=videos 
# Azure AI Language (sentiment analysis of comments). Optional: comments still work without it.
AZURE_LANGUAGE_ENDPOINT=https://<your-language-resource>.cognitiveservices.azure.com
AZURE_LANGUAGE_KEY=<key 1 from Keys and Endpoint>
